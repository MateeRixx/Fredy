# Fraud Command — environment template
# Copy to .env and adjust. All values have safe defaults.

# --- Application -----------------------------------------------------------
ENVIRONMENT=production
LOG_FORMAT=json
LOG_LEVEL=INFO

# Comma-separated list of allowed origins. "*" permits all.
# On Render/Railway the app and UI are served from the same origin, so "*" is safe.
CORS_ORIGINS=["*"]

# --- Analyst console login -------------------------------------------------
# Set these before exposing the console outside your machine.
AUTH_EMAIL=analyst@example.com
AUTH_PASSWORD=change-me
# AUTH_SESSION_SECRET=replace-with-a-long-random-value

# Injected by Render/Railway/Fly.io — do not set manually on those platforms.
# PORT=8000
